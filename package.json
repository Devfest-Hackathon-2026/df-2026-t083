{
  "name": "danmaku-slide",
  "private": true,
  "type": "module",
  "scripts": {
    "config": "node scripts/gen-config.mjs",
    "dev": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore --project danmaku-slide-test 'node test/rules.test.mjs'",
    "test:e2e": "node test/e2e.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "firebase deploy --only hosting,firestore:rules",
    "preview": "firebase hosting:channel:deploy preview --expires 7d"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0"
  }
}
